rules_version = '2';
// Security rules for the tracker's encrypted vaults.
// Each document ID is derived from username + passphrase, so a vault can only be
// read, written, or deleted by someone who knows both. Listing is never allowed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /vaults/{id} {
      allow get, delete: if id.matches('^[0-9a-f]{64}$');
      allow list: if false;
      allow create, update: if id.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['ct', 'iv', 'updated'])
        && request.resource.data.ct is string
        && request.resource.data.ct.size() < 400000
        && request.resource.data.iv is string
        && request.resource.data.iv.size() < 32
        && request.resource.data.updated == request.time;
    }
    // Thumbs up / down counts: ONE document holding every resource's counts, so a homepage visit
    // costs a single read. Each vote names its resource in last_vote; only that resource's counts
    // may change, each by at most 1, and never below 0.
    match /stats/ratings {
      allow get: if true;
      allow create: if validVote(request.resource.data, {});
      allow update: if validVote(request.resource.data, resource.data);
    }
    function validVote(after, before) {
      let k = after.last_vote;
      let changed = after.diff(before).affectedKeys();
      let now = after[k];
      let was = before.get(k, {'up': 0, 'down': 0});
      return k is string && k.matches('^[a-z0-9-]{1,80}$')
        && changed.hasOnly([k, 'last_vote']) && changed.hasAll([k])
        && now.keys().hasOnly(['up', 'down'])
        && now.get('up', 0) is int && now.get('down', 0) is int
        && now.get('up', 0) >= 0 && now.get('down', 0) >= 0
        && math.abs(now.get('up', 0) - was.get('up', 0)) <= 1
        && math.abs(now.get('down', 0) - was.get('down', 0)) <= 1;
    }
    // Reports shared with a therapist. Encrypted in the browser; the key is only in the link.
    // A report can be read until it expires; anyone holding the link (or the owner) can remove it.
    match /shares/{id} {
      allow get: if id.matches('^[0-9a-f]{32}$') && resource.data.expires > request.time;
      allow list, update: if false;
      allow delete: if id.matches('^[0-9a-f]{32}$');
      allow create: if id.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['ct', 'iv', 'created', 'expires'])
        && request.resource.data.ct is string
        && request.resource.data.ct.size() < 400000
        && request.resource.data.iv is string
        && request.resource.data.iv.size() < 32
        && request.resource.data.created == request.time
        && request.resource.data.expires is timestamp
        && request.resource.data.expires > request.time
        && request.resource.data.expires <= request.time + duration.value(31, 'd');
    }
    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
