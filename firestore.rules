rules_version = '2';
// Security rules for the tracker's encrypted vaults.
// Each document ID is derived from username + passphrase, so a vault can only be
// read, written, or deleted by someone who knows both. Listing is never allowed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /vaults/{id} {
      allow get, delete: if id.matches('^[0-9a-f]{64}$');
      allow list: if false;
      allow create, update: if id.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['ct', 'iv', 'updated'])
        && request.resource.data.ct is string
        && request.resource.data.ct.size() < 400000
        && request.resource.data.iv is string
        && request.resource.data.iv.size() < 32
        && request.resource.data.updated == request.time;
    }
    // Thumbs up / down counts, readable by everyone. Each write can move a count by at most 1.
    match /ratings/{id} {
      allow get, list: if true;
      allow create: if id.matches('^[a-z0-9-]{1,80}$')
        && request.resource.data.keys().hasOnly(['up', 'down'])
        && request.resource.data.get('up', 0) is int
        && request.resource.data.get('down', 0) is int
        && request.resource.data.get('up', 0) >= 0
        && request.resource.data.get('down', 0) >= 0
        && request.resource.data.get('up', 0) + request.resource.data.get('down', 0) == 1;
      allow update: if request.resource.data.keys().hasOnly(['up', 'down'])
        && request.resource.data.up is int && request.resource.data.down is int
        && request.resource.data.up >= 0 && request.resource.data.down >= 0
        && math.abs(request.resource.data.up - resource.data.get('up', 0)) <= 1
        && math.abs(request.resource.data.down - resource.data.get('down', 0)) <= 1;
      allow delete: if false;
    }
    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
